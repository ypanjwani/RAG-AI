{
  "name": "explainer-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:viewer && concurrently -k -n app,api -c blue,magenta \"vite\" \"node scripts/dev-api.mjs\"",
    "dev:app": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "build": "npm run build:viewer && vite build",
    "typecheck": "tsc -p tsconfig.app.json",
    "test": "vitest run && node scripts/export-server.mjs --check && node scripts/vendor-vega.mjs --check",
    "test:server": "node scripts/test-server.mjs",
    "export:server": "node scripts/export-server.mjs",
    "parity": "node scripts/parity.mjs && npm run test:server"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "plotly.js-cartesian-dist-min": "^4.1.2",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@types/katex": "^0.16.8",
    "concurrently": "^10.0.6",
    "jsdom": "^26.1.0",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
